# Base da REST API local do Solibri.
# O Solibri sobe em HTTPS por padrao; inicie com --rest-api-server-http para usar HTTP.
SOLIBRI_BASE_URL=http://127.0.0.1:10876/solibri/v1

# Timeout padrao das chamadas REST, em milissegundos.
SOLIBRI_TIMEOUT_MS=60000

# Executavel do Solibri, usado somente pelo modo Autorun.
SOLIBRI_EXE=C:\Program Files\Solibri\SOLIBRI\Solibri.exe

# Unica pasta em que o MCP pode ler e gravar arquivos.
SOLIBRI_WORKSPACE=F:\CLAUDE\MCP SOLIBRI\workspace

# 1 = so permite rulesets listados em config/approved-rulesets.json
SOLIBRI_STRICT_RULESETS=0
